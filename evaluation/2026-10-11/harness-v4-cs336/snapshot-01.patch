+/* Insert fence newlines for rendering only, with exact source-offset mapping. */
+export function prepareMathMarkdown(raw) {
+  const insertions = new Set();
+  const lines = [...raw.matchAll(/[^\n]*(?:\n|$)/g)].filter((m) => m[0]);
+  let codeFence = null, open = null, adapted = 0;
+  for (const match of lines) {
+    const line = match[0], offset = match.index;
+    const code = /^ {0,3}(`{3,}|~{3,})/.exec(line);
+    if (code && open === null) {
+      if (!codeFence) codeFence = code[1];
+      else if (code[1][0] === codeFence[0] && code[1].length >= codeFence.length) codeFence = null;
+      continue;
+    }
+    if (codeFence) continue;
+    if (open === null) {
+      const start = /^ {0,3}\$\$/.exec(line);
+      if (!start) continue;
+      const local = line.indexOf("$$");
+      // Existing one-line displays are already handled by the Markdown adapter.
+      if (line.indexOf("$$", local + 2) !== -1) continue;
+      open = offset + local;
+      if (line.slice(local + 2).trim()) insertions.add(open + 2);
+    } else {
+      const end = /\$\$\s*$/.exec(line);
+      if (!end) continue;
+      if (line.slice(0, end.index).trim()) insertions.add(offset + end.index);
+      if (insertions.has(open + 2) || insertions.has(offset + end.index)) adapted++;
+      open = null;
+    }
+  }
+  if (open !== null) throw Error("Unclosed display math at source offset " + open);
+  let text = "";
+  const offsets = [];
+  for (let i = 0; i < raw.length; i++) {
+    if (insertions.has(i)) { text += "\n"; offsets.push(i); }
+    text += raw[i]; offsets.push(i);
+  }
+  offsets.push(raw.length);
+  return { text, sourceOffset: (offset) => offsets[offset], adapted };
+}
