  "annotations": [
    {
      "id": "note-mla-cache-condition",
      "afterAnchor": "cache-011",
      "kind": "correction",
      "text": "解耦 RoPE 的 MLA 还要缓存位置键 kᴿ，不能只计算潜变量 cᴷⱽ。若潜变量维度为 C、位置键维度为 R，则每个 token、每层持久缓存 C+R 个元素；内容 K/V 可由潜变量展开，实际实现也可将部分投影吸收进计算。",
      "formula": "M_{\\mathrm{MLA}}=LBSe(C+R)"
    },
    {
      "id": "note-budget-condition",
      "afterAnchor": "cache-008",
      "kind": "condition",
      "text": "L 层、B 条序列、每条 S 个 token、K 个 KV 头、每头 H 维、每元素 e 字节。其余量固定时，缓存比例才是 K/N；它不是实测加速比。",
      "formula": "M_{\\mathrm{KV}}=2LBSKHe",
      "placement": "margin"
    }
  ]
